# Luma Foundry — environment variables
#
# Copy to .env and fill in real values. NEVER commit .env itself.

# Supabase project (regional endpoint; ap-south-1 = Mumbai)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY

# Postgres connection.
# Uses the app_user role (BYPASSRLS = false) so RLS applies.
# Format: postgresql://app_user.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://app_user.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Local dev / runtime
PORT=3000
NODE_ENV=development

# MCP server identity. Only read by packages/mcp-server at stdio startup.
# Set to a Supabase auth UUID to bind the MCP server process to one user.
# Leave empty for in-memory dev.
LUMA_AUTH_USER_ID=
